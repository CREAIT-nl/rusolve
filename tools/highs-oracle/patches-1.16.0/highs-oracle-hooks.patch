--- /dev/null
+++ b/highs/mip/HighsOracleAcDump.h
@@ -0,0 +1,71 @@
+/* rusolve oracle instrumentation -- NOT part of upstream HiGHS.
+ *
+ * Added by tools/highs-oracle/highs-oracle-hooks.patch. When the environment
+ * variable HIGHS_ORACLE_AC_DUMP names a file, the patched HiGHS MIP code
+ * appends one JSON line per IPM result (analytic centre, and the LP
+ * relaxation's IPM fallback) so that the Rust port can replay them. Records
+ * are described in tools/highs-oracle/FORMAT.md ("ac" and "lp_ipm"). The file
+ * is truncated by the first record of the process. Without the variable,
+ * nothing is written. The functions only read solver state.
+ */
+#ifndef MIP_HIGHSORACLEACDUMP_H_
+#define MIP_HIGHSORACLEACDUMP_H_
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+// The dump file, or nullptr when HIGHS_ORACLE_AC_DUMP is unset.
+inline std::FILE* highsOracleAcFile() {
+  static std::FILE* file = nullptr;
+  static bool opened = false;
+  if (!opened) {
+    opened = true;
+    const char* path = std::getenv("HIGHS_ORACLE_AC_DUMP");
+    if (path != nullptr && path[0] != '\0') file = std::fopen(path, "w");
+  }
+  return file;
+}
+
+// Starts a record: {"t":<tag>,"call":<n>,"submip":<0|1>,"submip_level":<l>,
+// "model_status":<s>. The caller appends fields and then calls
+// highsOracleAcEnd. Returns nullptr when dumping is off. `call` counts the
+// records of the process in emission order.
+inline std::FILE* highsOracleAcBegin(const char* tag, bool submip,
+                                     long long submip_level,
+                                     int model_status) {
+  std::FILE* f = highsOracleAcFile();
+  if (f == nullptr) return nullptr;
+  static long long call_index = 0;
+  std::fprintf(f,
+               "{\"t\":\"%s\",\"call\":%lld,\"submip\":%d,"
+               "\"submip_level\":%lld,\"model_status\":%d",
+               tag, call_index++, submip ? 1 : 0, submip_level, model_status);
+  return f;
+}
+
+inline void highsOracleAcEnd(std::FILE* f) {
+  std::fputs("}\n", f);
+  std::fflush(f);
+}
+
+// ,"<key>":["0x1.8p+1",...] with %a (exact hexfloat, sign of zero kept).
+inline void highsOracleAcDoubles(std::FILE* f, const char* key,
+                                 const std::vector<double>& v) {
+  std::fprintf(f, ",\"%s\":[", key);
+  for (size_t i = 0; i < v.size(); ++i)
+    std::fprintf(f, "%s\"%a\"", i == 0 ? "" : ",", v[i]);
+  std::fputc(']', f);
+}
+
+// ,"<key>":[1,0,...] for enums and integers (converted with static_cast<int>).
+template <typename T>
+inline void highsOracleAcInts(std::FILE* f, const char* key,
+                              const std::vector<T>& v) {
+  std::fprintf(f, ",\"%s\":[", key);
+  for (size_t i = 0; i < v.size(); ++i)
+    std::fprintf(f, "%s%d", i == 0 ? "" : ",", static_cast<int>(v[i]));
+  std::fputc(']', f);
+}
+
+#endif
