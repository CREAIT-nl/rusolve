+/* rusolve oracle instrumentation -- NOT part of upstream HiGHS.
+ *
+ * Added by tools/highs-oracle/highs-oracle-hooks.patch. Defines a process-wide
+ * table of observer callbacks that the patched HEkk / HEkkDual / HEkkPrimal
+ * call at fixed points. All hooks are null by default, in which case the
+ * patched library behaves exactly like upstream HiGHS: a hook only reads
+ * solver state, it never changes it.
+ */
+#ifndef SIMPLEX_HIGHSORACLEHOOK_H_
+#define SIMPLEX_HIGHSORACLEHOOK_H_
+
+class HEkk;
+class HEkkDual;
+class HEkkPrimal;
+
+// HEkk events
+const int kOracleEkkSolveEnter = 0;        // HEkk::solve, before initialiseForSolve
+const int kOracleEkkSolveInitialised = 1;  // HEkk::solve, after initialiseForSolve
+const int kOracleEkkSolveExit = 2;         // HEkk::returnFromEkkSolve
+const int kOracleEkkComputeFactor = 3;     // HEkk::computeFactor, after INVERT
+// HEkkDual / HEkkPrimal events
+const int kOracleSolveStart = 10;  // phase decided, before the major loop
+const int kOracleRebuild = 11;     // after each rebuild()
+const int kOracleIterate = 12;     // after each iterate()
+const int kOracleCleanup = 13;     // end of cleanup()
+const int kOraclePhaseEnd = 14;    // after solvePhase1()/solvePhase2() returns
+const int kOracleRebuildEnter = 15;  // immediately before each rebuild()
+
+struct HighsOracleHooks {
+  void (*ekk)(int event, HEkk& ekk) = nullptr;
+  void (*dual)(int event, HEkkDual& dual) = nullptr;
+  void (*primal)(int event, HEkkPrimal& primal) = nullptr;
+};
+
+// Function-local static in an inline function: one instance per program
+// (C++11, no inline variables needed).
+inline HighsOracleHooks& highsOracleHooks() {
+  static HighsOracleHooks hooks;
+  return hooks;
+}
+
+#define HIGHS_ORACLE_EKK(event) \
+  do { if (highsOracleHooks().ekk) highsOracleHooks().ekk(event, *this); } while (0)
+#define HIGHS_ORACLE_DUAL(event) \
+  do { if (highsOracleHooks().dual) highsOracleHooks().dual(event, *this); } while (0)
+#define HIGHS_ORACLE_PRIMAL(event) \
+  do { if (highsOracleHooks().primal) highsOracleHooks().primal(event, *this); } while (0)
+
+#endif
